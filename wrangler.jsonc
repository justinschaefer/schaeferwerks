{
  "name": "schaeferwerks-45b0",
  "compatibility_date": "2026-09-04",
  "main": "worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // The worker checks for Cloudflare Access sign-in before serving anything under /rv.
    "run_worker_first": ["/rv", "/rv/*"]
  },
  // Star ranks and passes for Coast Land Scout and RV Scout (keys "ratings" and "rv-ratings"). Wrangler creates the namespace on first deploy.
  "kv_namespaces": [
    { "binding": "COAST" }
  ],
  // Cloudflare Access only guards schaeferwerks.com, so keep the private /coast and /rv pages off the other URLs.
  "workers_dev": false,
  "preview_urls": false
}
