<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.schaeferwerks.landscout</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-c</string>
    <string>$HOME/LandScout/run.sh &gt;&gt; $HOME/LandScout/logs/run.log 2&gt;&amp;1</string>
  </array>
  <!-- Every day at 6:07 AM. If the Mac is asleep then, it runs when the Mac wakes. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>7</integer>
  </dict>
</dict>
</plist>
